rules_version = '2';

// ============================================================
//  Horizon Psagot Group — Firestore Security Rules
//  מודל תפקידים: owner (הכל) · manager (לידים + תוכן + משימות) · agent (לידים + משימות שלו)
//  התפקיד נשמר ב-crm_users/{uid}.role
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- עזרים ----------
    function signedIn() {
      return request.auth != null;
    }
    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/crm_users/$(request.auth.uid));
    }
    function myRole() {
      // מחזיר את התפקיד של המשתמש המחובר, או 'none' אם אין לו פרופיל
      return hasProfile()
        ? get(/databases/$(database)/documents/crm_users/$(request.auth.uid)).data.role
        : 'none';
    }
    function isOwner()   { return myRole() == 'owner'; }
    function canContent(){ return myRole() == 'owner' || myRole() == 'manager'; }
    // האם הבקשה משנה את שדה 'role' של המסמך
    function touchesRole() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    // ---------- לידים ----------
    // כל אחד יכול לשלוח פנייה (טופס האתר / פייסבוק); רק צוות מחובר רואה ועורך.
    match /leads/{doc} {
      allow create: if (request.resource.data.name is string
                        && request.resource.data.phone is string
                        && request.resource.data.name.size() < 300
                        && request.resource.data.phone.size() < 60)
                     || signedIn();               // צוות יכול ליצור ליד ידני
      allow read, update, delete: if signedIn();  // כל תפקיד מטפל בלידים
    }

    // ---------- תוכן מוצג באתר ----------
    // כולם קוראים (התוכן מוצג לגולשים); רק owner/manager עורכים.
    match /deals/{doc}        { allow read: if true; allow write: if canContent(); }
    match /testimonials/{doc} { allow read: if true; allow write: if canContent(); }
    match /articles/{doc}     { allow read: if true; allow write: if canContent(); }
    match /team/{doc}         { allow read: if true; allow write: if canContent(); }
    match /faq/{doc}          { allow read: if true; allow write: if canContent(); }

    // ---------- משתמשים והרשאות ----------
    // כל צוות מחובר קורא את הרשימה.
    // רק owner מוסיף/מסיר משתמשים או משנה תפקידים.
    // כל משתמש מעדכן רק את המסמך של עצמו — ולעולם לא את שדה 'role' של עצמו
    // (מונע הסלמת הרשאות: agent לא יכול להפוך את עצמו ל-owner).
    match /crm_users/{uid} {
      allow read: if signedIn();
      allow delete: if isOwner();
      // owner יוצר משתמשים עם תפקיד · משתמש חדש יוצר את המסמך של עצמו בלי 'role'
      allow create: if isOwner()
                    || (request.auth.uid == uid && !('role' in request.resource.data));
      allow update: if isOwner()
                    || (request.auth.uid == uid && !touchesRole());
      // הערה: יצירת ה-owner הראשון נעשית ידנית ב-Firebase Console
      // (מסמך crm_users/<uid> עם role:"owner"). ראו CRM-SETUP.md.
    }

    // ---------- תיקי לקוחות (פורטל מסמכים) ----------
    // הצוות (מי שיש לו פרופיל ב-crm_users) רואה ומנהל את כל התיקים.
    // לקוח ניגש רק לתיק שבו הטלפון/מייל שלו תואם לזה שבתיק (בידוד מלא).
    // שינוי מצב התיק (סגירה/פתיחה מחדש) — פעולה ניהולית
    function touchesCaseStatus() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'closedAt', 'closedBy']);
    }
    function ownsCase(data) {
      return (data.clientPhone != null && request.auth.token.phone_number != null
                && data.clientPhone == request.auth.token.phone_number)
          || (data.clientEmail != null && request.auth.token.email != null
                && data.clientEmail == request.auth.token.email);
    }
    match /cases/{caseId} {
      allow read:   if hasProfile() || (signedIn() && ownsCase(resource.data));
      allow create: if hasProfile();                       // כל הצוות פותח תיק
      allow delete: if isOwner();                          // מחיקת תיק — בעלים בלבד
      // הצוות מעדכן הכל; לקוח מעדכן רק את התיק שלו, בלי לשנות שדות זיהוי/הרשאה
      // תיק סגור (status == 'closed') — הלקוח בתצוגה בלבד, אין לו כתיבה
      // נציג (agent): מטפל בתיק — מאשר/דוחה מסמכים, מוסיף בקשות.
      // סגירת תיק / פתיחה מחדש — owner או manager בלבד.
      allow update: if (hasProfile() && (canContent() || !touchesCaseStatus()))
                    || (signedIn() && ownsCase(resource.data)
                        && resource.data.status != 'closed'
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.clientPhone == resource.data.clientPhone
                        && request.resource.data.clientEmail == resource.data.clientEmail
                        && request.resource.data.serviceType == resource.data.serviceType
                        && request.resource.data.createdBy == resource.data.createdBy);
    }

    // ---------- משימות (ניהול משימות לצוות) ----------
    // מודל: כל משימה = {title, assignedUid, createdByUid, private, status, ...}
    //  · private=true רק כשבעלים יצר משימה לבעלים ולא סימן "גלוי לצוות"
    //    → נסתרת מכל מי שאינו בעלים (נאכף כאן, לא רק ב-UI)
    //  · בעלים: הכל · מנהל: הכל חוץ ממשימות שבעלים יצר (בהן: סטטוס/תגובות בלבד)
    //  · נציג: יוצר לעצמו, רואה את הצוות (קריאה), מעדכן סטטוס/תגובות רק במשימות שלו
    function roleOf(uid) {
      return exists(/databases/$(database)/documents/crm_users/$(uid))
        ? get(/databases/$(database)/documents/crm_users/$(uid)).data.role : 'none';
    }
    function taskParticipant(d) {
      return d.assignedUid == request.auth.uid || d.createdByUid == request.auth.uid;
    }
    // עדכון "מוגבל": רק התקדמות בביצוע — לא כותרת/אחראי/דדליין/מחיקה
    function taskLimitedUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'completedAt', 'completedBy', 'comments', 'activity',
                  'completedByUid', 'updatedAt', 'updatedBy', 'occurrences', 'dueDate', 'seenBy'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dueDate'])
            || resource.data.repeat in ['daily', 'weekly', 'monthly']);   // דדליין זז רק במשימה חוזרת
    }
    match /tasks/{taskId} {
      allow read: if hasProfile() && (isOwner() || resource.data.private == false);
      allow create: if hasProfile()
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() < 300
                    && request.resource.data.createdByUid == request.auth.uid
                    && request.resource.data.assignedUid is string
                    && (myRole() != 'agent' || request.resource.data.assignedUid == request.auth.uid)
                    && request.resource.data.private is bool
                    && (request.resource.data.private == false
                        || (isOwner() && roleOf(request.resource.data.assignedUid) == 'owner'));
      allow update: if hasProfile() && (
                      isOwner()
                      || (myRole() == 'manager'
                          && resource.data.private == false
                          && request.resource.data.private == false
                          && (roleOf(resource.data.createdByUid) != 'owner' || taskLimitedUpdate()))
                      || (myRole() == 'agent'
                          && taskParticipant(resource.data)
                          && request.resource.data.private == false
                          && request.resource.data.assignedUid == request.auth.uid
                          && (resource.data.createdByUid == request.auth.uid || taskLimitedUpdate()))
                    );
      allow delete: if hasProfile() && (
                      isOwner()
                      || (myRole() == 'manager' && resource.data.private == false
                          && roleOf(resource.data.createdByUid) != 'owner')
                      || (myRole() == 'agent' && resource.data.createdByUid == request.auth.uid
                          && resource.data.assignedUid == request.auth.uid)
                    );
    }

    // ---------- ברירת מחדל: כל השאר חסום ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
